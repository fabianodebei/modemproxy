# Auto-generated by modemproxy for modem {{ name }} ({{ imei }}). DO NOT EDIT.
nserver {{ dns }}
nscache 65536
timeouts 1 5 30 60 180 1800 15 60
log /var/log/modemproxy/3proxy.{{ svc }}.log D
logformat "- +_L%t.%. %N.%p %E %U %C:%c %R:%r %O %I %h %T"
rotate 7

{# all_users = main login + extra logins (e.g. storefront customers): every one
   of them is accepted on this modem's ports. #}
{% if all_users %}
{% for u in all_users %}users {{ u.username }}:CL:{{ u.password }}
{% endfor %}auth strong
allow {{ all_users | map(attribute='username') | join(',') }}{% if white_list %} {{ white_list }}{% endif %}
{% elif white_list %}
auth iponly
allow * {{ white_list }}
{% else %}
auth none
{% endif %}

# Bind outbound traffic to this modem's interface so each proxy egresses
# through its own SIM / public IP.
external {{ modem_ip }}
internal {{ bind_address }}

# HTTP/HTTPS proxy
proxy -p{{ http_port }} -i{{ bind_address }} -e{{ modem_ip }}

# SOCKS5 proxy
socks -p{{ socks_port }} -i{{ bind_address }} -e{{ modem_ip }}

flush
