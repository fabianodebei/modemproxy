# Auto-generated by modemproxy: ROTATING POOL PORT. DO NOT EDIT.
# One address for all SIMs: every new client connection is handed to one of
# the live per-modem proxies below (3proxy weighted-random "parent" chain).
nserver {{ dns }}
nscache 65536
timeouts 1 5 30 60 180 1800 15 60
log /var/log/modemproxy/3proxy.pool.log D
logformat "- +_L%t.%. %N.%p %E %U %C:%c %R:%r %O %I %h %T"
rotate 7

users {{ username }}:CL:{{ password }}
internal {{ bind_address }}

# Parent type is "connect" (HTTP CONNECT tunnel), NOT "http": 3proxy's "http"
# parents only relay plain GET/POST and refuse CONNECT, which breaks every
# HTTPS request (log code 00006). A CONNECT tunnel to the per-modem HTTP port
# carries any TCP — plain HTTP, HTTPS and the SOCKS service alike.
# "parent" lines attach to the preceding "allow".

# HTTP/HTTPS
auth strong
allow {{ username }}
{% for m in members %}parent {{ m.weight }} connect 127.0.0.1 {{ m.http_port }}{% if m.username %} {{ m.username }} {{ m.password }}{% endif %}
{% endfor %}proxy -p{{ http_port }} -i{{ bind_address }}
flush

# SOCKS5 (tunnelled through the same per-modem CONNECT parents)
auth strong
allow {{ username }}
{% for m in members %}parent {{ m.weight }} connect 127.0.0.1 {{ m.http_port }}{% if m.username %} {{ m.username }} {{ m.password }}{% endif %}
{% endfor %}socks -p{{ socks_port }} -i{{ bind_address }}
flush
